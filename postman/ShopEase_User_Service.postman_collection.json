    {
      "name": "00 Auth - register user A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = Date.now(); pm.collectionVariables.set(\"email_a\", \"alice\" + t + \"@example.com\"); pm.collectionVariables.set(\"email_b\", \"bob\" + t + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{auth_url}}/api/auth/register",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Alice User\",\n  \"password\": \"Strong@123\",\n  \"confirm_password\": \"Strong@123\",\n  \"email\": \"{{email_a}}\"\n}"
        }
      }
    },
